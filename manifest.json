{
  "id": "./",
  "name": "Mobile Code - SPCK clone",
  "short_name": "Mobile Code",
  "description": "Mobile-first browser IDE \u2014 edit HTML/CSS/JS langsung dari HP.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#1e1e1e",
  "theme_color": "#1e1e1e",
  "lang": "id",
  "dir": "ltr",
  "categories": [
    "developer",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/css": [
          ".css"
        ],
        "text/javascript": [
          ".js",
          ".mjs"
        ],
        "application/json": [
          ".json"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
